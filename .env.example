# Copy to .env (gitignored) or set runtime.auth.env_file in trial.yaml to an existing file,
# e.g. ~/Private/Secret/xxRC/.env. Only the variable NAME goes in config, never the value.

# auth.mode: api_key
ANTHROPIC_API_KEY=

# auth.mode: oauth (long-lived token from `claude setup-token`).
# Any name works, set auth.token_env to it, e.g. TOC_CLAUDE_CODE_OAUTH_TOKEN.
CLAUDE_CODE_OAUTH_TOKEN=
